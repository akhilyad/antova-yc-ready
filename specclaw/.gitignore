# This folder also holds Antova's files. Ignore everything at the top
# level, then allow only Specclaw's own files and folders.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/conftest.py
!/pytest.ini
!/specclaw_*.py
!/specclaw_*.md
!/specclaw_*.html
!/specclaw_*.js
!/specclaw_*.jsx
!/specclaw_requirements.txt
!/test_specclaw*.py
!/build_frontend.py
!/specclaw_ingest/
!/samples/
!/docs/
!/web/

# Internal strategy notes: kept on disk, never published. These come after the allowlist
# above, which would otherwise let them through (/specclaw_*.md).
/specclaw_yc_2027_master_blueprint.md
/specclaw_interactive_mvp_prototype.md

# Secrets and local configuration: never committed, at any depth. Only a documented
# .env.example (names, no values) may be.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
credentials*.json
service-account*.json
secrets/

# Local runtime data and caches (never committed)
specclaw_enterprise.db
*.db
*.sqlite
*.sqlite3
samples/**/runs/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Frontend build output and dependencies
web/node_modules/
web/dist/
web/dist-ssr/
web/dist-e2e/
web/dist-e2e-ssr/
web/test-results/
web/playwright-report/
web/coverage/
web/e2e/.tmp/

# Local tool and assistant state (nothing in these belongs to the product)
.claude/
.superpowers/
.impeccable/
graphify-out/

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
