# Copy to .env (never commit .env). Only names starting with ANTHROPIC_, EXPLABS_, SPECCLAW_ or
# ANTOVA_ are read from it; a variable already set in the shell wins.

# --- Locate model: Experiential Labs (OpenAI-compatible) ---------------------------------------
# With only this key set, ingests use it. Set SPECCLAW_LOCATE_PROVIDER=anthropic to force Claude.
EXPLABS_API_KEY=
# EXPLABS_MODEL=gpt-6-luna
# EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
# The model's context for one call. A longer bid is sent in overlapping page windows.
# EXPLABS_MAX_INPUT_TOKENS=100000
# Output limit (max_tokens). Unset leaves the endpoint's default; raise it if a reply is cut off.
# EXPLABS_MAX_OUTPUT_TOKENS=32000
# Set to off if the endpoint rejects response_format.
# EXPLABS_JSON_MODE=json_object
# USD per million tokens, for the run-cost figure. Unset counts as 0.
# EXPLABS_PRICE_INPUT_PER_MTOK=
# EXPLABS_PRICE_OUTPUT_PER_MTOK=
# SPECCLAW_LOCATE_PROVIDER=explabs
# SPECCLAW_LOCATE_CONCURRENCY=3

# --- Locate model: Claude ------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# --- Review ----------------------------------------------------------------------------------------
# ANTOVA_REVIEW_TOKEN=
