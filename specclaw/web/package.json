{
  "name": "antova-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run prerender",
    "prerender": "vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "build:e2e": "tsc -b && vite build --outDir dist-e2e && vite build --ssr src/entry-server.tsx --outDir dist-e2e-ssr && tsx scripts/prerender.ts dist-e2e dist-e2e-ssr",
    "preview:e2e": "vite preview --outDir dist-e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "snapshot:sample": "tsx scripts/snapshot-sample.ts",
    "snapshot:crops": "tsx scripts/snapshot-sample.ts --crops-only",
    "check:launch": "tsx scripts/check-launch.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "decimal.js-light": "^2.5.1",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
