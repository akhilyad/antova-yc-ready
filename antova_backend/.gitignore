# This folder also holds Antova's files. Ignore everything at the top
# level, then allow only Antova's own files and folders.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/conftest.py
!/pytest.ini
!/antova_*.py
!/antova_*.md
!/antova_*.html
!/antova_*.js
!/antova_*.jsx
!/antova_requirements.txt
!/test_antova*.py
!/antova_ingest/
!/samples/
!/docs/
!/web/

# Internal strategy notes: kept on disk, never published. These come after the allowlist
# above, which would otherwise let them through (/antova_*.md).
/antova_yc_2027_master_blueprint.md
/antova_interactive_mvp_prototype.md

# Secrets and local configuration: never committed, at any depth. Only a documented
# .env.example (names, no values) may be.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
credentials*.json
service-account*.json
secrets/

# Local runtime data and caches (never committed)
antova_enterprise.db
*.db
*.sqlite
*.sqlite3
samples/**/runs/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Frontend build output and dependencies
web/node_modules/
web/dist/
web/dist-ssr/
web/dist-e2e/
web/dist-e2e-ssr/
web/test-results/
web/playwright-report/
web/coverage/
web/e2e/.tmp/

# Local tool and assistant state (nothing in these belongs to the product)
.superpowers/
.impeccable/
graphify-out/

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
